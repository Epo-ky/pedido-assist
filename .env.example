# Copie para .env e preencha. O .env NUNCA vai para o git.
# Postgres local (instalado no Windows, porta 5432). Troque SUA_SENHA pela senha do usuario postgres.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/pedido_assist

# Usado nas fases 2 e 4
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
# Chave gratuita em console.groq.com (o plano gratuito não cobra).
GROQ_API_KEY=
# Opcional. Padrão: openai/gpt-oss-120b (outras opções com tools: openai/gpt-oss-20b, qwen/qwen3.8-27b)
# GROQ_MODEL=openai/gpt-oss-120b
